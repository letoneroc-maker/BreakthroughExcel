{
  "name": "excel-data-analyzer",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "type": "module",
  "description": "Excel数据分析工具",
  "author": "Excel Analyzer",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "electron:dev": "vite dev",
    "electron:build": "tsc -b && vite build && electron-builder",
    "electron:package": "electron-builder --dir"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^5.4.0",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "build": {
    "appId": "com.excelanalyzer.app",
    "productName": "Excel数据分析工具",
    "copyright": "Copyright © 2026 Excel Analyzer",
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "public/favicon.svg",
      "uninstallerIcon": "public/favicon.svg",
      "installerHeaderIcon": "public/favicon.svg"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/preload.js"
    ],
    "directories": {
      "output": "dist-electron"
    }
  }
}
